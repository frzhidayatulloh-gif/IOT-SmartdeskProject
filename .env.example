# Ganti dengan ID unik kelompok, huruf kecil dan angka disarankan
PROJECT_ID=kelompok-ganti-id
DEVICE_ID=hpA

MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883

# Termux:API sensor names may differ by phone. Check: termux-sensor -l
LIGHT_SENSOR_NAME=LIGHT
ACCEL_SENSOR_NAME=ACCELEROMETER

SAMPLE_INTERVAL_SECONDS=1
WINDOW_SIZE=5
LUX_THRESHOLD=300
MOTION_RMS_THRESHOLD=0.7
